{
  "schema_version": "1",
  "id": "questionnaire",
  "title": "Project Kickoff Questionnaire",
  "stages": [
    {
      "id": "intake",
      "artifact_type": "form",
      "allowed_actions": ["edit", "revise", "approve", "reopen"],
      "approval_required": true,
      "form_schema": {
        "type": "object",
        "properties": {
          "project_name": {
            "type": "string",
            "title": "What is your project name?"
          },
          "goal": {
            "type": "string",
            "title": "What is the main goal of this project?"
          },
          "target_users": {
            "type": "string",
            "title": "Who are the target users?"
          },
          "timeline": {
            "type": "string",
            "enum": ["1-2 weeks", "1 month", "2-3 months", "6+ months"],
            "title": "Expected timeline?"
          },
          "budget": {
            "type": "string",
            "enum": ["< $5k", "$5k-$20k", "$20k-$100k", "$100k+"],
            "title": "Budget range?"
          },
          "tech_stack": {
            "type": "string",
            "title": "Preferred tech stack (if any)?"
          },
          "biggest_risk": {
            "type": "string",
            "title": "What is the biggest risk or unknown?"
          }
        }
      }
    },
    {
      "id": "summary",
      "artifact_type": "text",
      "depends_on": ["intake"],
      "allowed_actions": ["edit", "revise", "approve", "reopen"],
      "approval_required": true
    }
  ],
  "completion": {
    "require_approved_stages": ["intake", "summary"]
  }
}
