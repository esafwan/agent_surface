# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# Packaging
*.egg-info/
build/
dist/

# Runtime state
.surface-board/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Browser testing artifacts
.playwright-mcp/

# Agent worktrees (created by the Agent tool's isolation:"worktree" option;
# never a place code should land in a real commit)
.claude/worktrees/

# Example runtime artifacts (each example writes its own store/logs when run)
examples/**/*.log
examples/**/interactions/
examples/**/turn.json
examples/**/question.json
examples/**/run/
